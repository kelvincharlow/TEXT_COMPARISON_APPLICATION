# Allow only backend source and isolated test inputs into the build context.
**
!requirements.txt
!alembic.ini
!backend/
!backend/__init__.py
!backend/app/
!backend/app/**
!backend/migrations/
!backend/migrations/**
!backend/Dockerfile
!backend/tests/
!backend/tests/**
!poc/
!poc/*.py
!poc/ground_truth/
!poc/ground_truth/*.json
**/__pycache__/
**/*.py[cod]
