# Bind to the server's approved internal IP for UAT/production.
# 127.0.0.1 is the safe default for local verification.
POSTBANK_BIND_ADDRESS=127.0.0.1
POSTBANK_HTTP_PORT=8080

POSTBANK_MAX_UPLOAD_BYTES=26214400
POSTBANK_DOWNLOAD_TTL_SECONDS=900

POSTBANK_BACKEND_MEMORY_LIMIT=2g
POSTBANK_BACKEND_CPU_LIMIT=2.0
POSTBANK_FRONTEND_MEMORY_LIMIT=128m
POSTBANK_FRONTEND_CPU_LIMIT=0.5
